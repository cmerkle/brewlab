# Copy to .env (next to docker-compose.yml) — docker compose reads it automatically.
# Everything is optional; the app works fully without an LLM
# (Tesseract OCR for bag photos, manually entered candidates for the weekly refresh).

# Which provider: anthropic | openai | gemini | openai-compatible
LLM_PROVIDER=anthropic

# API key for that provider (optional for openai-compatible servers like Ollama)
LLM_API_KEY=

# Model id. Optional for anthropic (defaults to claude-opus-5-5);
# REQUIRED for openai, gemini and openai-compatible — use a current model id from
# your provider's docs. For bag photos the model must accept images.
LLM_MODEL=

# Override the API endpoint. REQUIRED for openai-compatible, e.g.
#   Ollama:     http://<host>:11434/v1
#   LM Studio:  http://<host>:1234/v1
#   OpenRouter: https://openrouter.ai/api/v1
# Optional for the others (proxies / gateways).
LLM_BASE_URL=
